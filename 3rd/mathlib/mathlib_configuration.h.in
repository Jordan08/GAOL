/* mathlib_configuration.h -- written from 3rd/mathlib/mathlib_configuration.h.in
   by the CMake, meson and autotools builds of GAOL.

   This is the header that mathlib's configure script writes, for every
   compiler: src/mathlib_config_msvc.h and src/mathlib_config_mingw.h, the
   configuration files src/mathlib_config.h includes instead for Visual C++ and
   MinGW, were replaced with files including this one (see ../README.md).

   Origin: the version of src/mathlib_configuration.h.in with which IBEX builds
   mathlib with CMake (https://github.com/ibex-team/ibex-lib,
   interval_lib_wrapper/gaol/3rd/mathlib-2.1.1/, Cyril Bouvier and Gilles
   Chabert), itself generated from mathlib's configure.ac. Only the macros
   mathlib's sources read are kept, and the ones describing the target are set
   by the preprocessor below rather than by the build system. */

#ifndef MATHLIB_CONFIGURATION_H
#define MATHLIB_CONFIGURATION_H

/* Define to 1 if you have the <fenv.h> header file: always, the builds of
   GAOL copying this file as it is. src/AARCH64_DPChange.c sets the rounding
   direction through <fenv.h>, and Init_Lib() does not compile without it
   (#error); GAOL needs it as well (gaol/gaol_fpu_fenv.h). */
#define HAVE_FENV_H 1

/* Define WORDS_BIGENDIAN to 1 if your processor stores words with the most
   significant byte first. Read by src/AARCH64_endian.h. The test on
   __BYTE_ORDER__, which GCC and Clang define, is the one of the fork of mathlib
   by Fabrice Le Bars (https://github.com/lebarsfa/mathlib,
   src/mathlib_endian.h); Visual C++ only targets little-endian processors. */
#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
#  define WORDS_BIGENDIAN 1
#endif

/* Define this if your system is ix86-based. src/endian.h then takes the byte
   order from src/IX86_endian.h, and from src/AARCH64_endian.h otherwise. */
#if defined(__i386__) || defined(__x86_64__) || defined(_M_IX86) || (defined(_M_X64) && !defined(_M_ARM64EC))
#  define IX86_CPU 1
#endif

/* The implementation of Init_Lib() and Exit_Lib(), which src/DPChange.c
   includes according to the macros below: src/AARCH64_DPChange.c, for every
   target, which was modified so that Init_Lib() sets the rounding
   direction to nearest, which mathlib's algorithms need, returns the one it
   found, and Exit_Lib() restores it. Nothing in it is specific to ARM64, and
   it goes through <fenv.h> alone.

   The versions mathlib's own build chooses for the other processors are not
   used, following the fork of mathlib by Fabrice Le Bars
   (https://github.com/lebarsfa/mathlib, src/DPChange.c):

    - src/LINUX64_DPChange.c (x86_64 Linux), src/LINUX_DPChange.c (32-bit x86)
      and src/IX86MACOSX_DPChange.c (Intel Macs) save the control word of the
      x87 unit in global variables, which two threads calling gaol::init()
      would write at once, to set its precision to 53 bits. GAOL restores the
      default floating-point environment right after calling Init_Lib()
      (gaol/gaol_common.cpp), whose precision is 64 bits on Linux and with
      MinGW: that setting is lost before mathlib computes anything, and GAOL
      computes the doubles of 32-bit x86 in SSE2 instead, which leaves nothing
      to the precision of the x87 (see CMakeLists.txt).
    - src/LINUX_DPChange.c is 32-bit x86 assembly, which names its variables
      with the decoration of 32-bit Windows and reaches them through absolute
      addresses, which linkers refuse in a shared library; src/MSVC_DPChange.c
      is 32-bit x86 assembly as well, which Visual C++ compiles for no other
      processor.
    - Other processors, 32-bit ARM among them, have no extended precision. */
#define MATHLIB_AARCH64 1

#endif /* MATHLIB_CONFIGURATION_H */
