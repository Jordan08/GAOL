CORE_MATH_DIR = math-core/src/binary64
libgaolcoremath_la_SOURCES = \
	$(CORE_MATH_DIR)/exp/exp.c $(CORE_MATH_DIR)/log/log.c \
	$(CORE_MATH_DIR)/pow/pow.c $(CORE_MATH_DIR)/sin/sin.c \
	$(CORE_MATH_DIR)/cos/cos.c $(CORE_MATH_DIR)/tan/tan.c \
	$(CORE_MATH_DIR)/asin/asin.c $(CORE_MATH_DIR)/acos/acos.c \
	$(CORE_MATH_DIR)/atan/atan.c $(CORE_MATH_DIR)/atan2/atan2.c \
	$(CORE_MATH_DIR)/sinh/sinh.c $(CORE_MATH_DIR)/cosh/cosh.c \
	$(CORE_MATH_DIR)/tanh/tanh.c $(CORE_MATH_DIR)/asinh/asinh.c \
	$(CORE_MATH_DIR)/acosh/acosh.c $(CORE_MATH_DIR)/atanh/atanh.c \
	$(CORE_MATH_DIR)/cbrt/cbrt.c \
	$(CORE_MATH_DIR)/exp2/exp2.c $(CORE_MATH_DIR)/exp10/exp10.c \
	$(CORE_MATH_DIR)/log2/log2.c $(CORE_MATH_DIR)/log10/log10.c

libgaolcoremath_la_CPPFLAGS = -I$(top_builddir) -I$(top_srcdir)
# -fno-lto keeps the interprocedural optimization away from these sources, where
# CFLAGS carries -flto: reached by it, sin and cos took half as long again, while
# it makes GAOL's own operations twice as fast (see doc/three-builds.md). The
# flag is given where the compiler takes it, which configure tested
# (CORE_MATH_NO_LTO).
libgaolcoremath_la_CFLAGS = $(AM_CFLAGS) @CORE_MATH_NO_LTO@ @CORE_MATH_EXCESS_PRECISION@ -include $(top_srcdir)/gaol/core_math_port.h
EXTRA_DIST = README.md math-core
all: all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu 3rd/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu 3rd/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}
$(CORE_MATH_DIR)/exp/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/exp
	@: > $(CORE_MATH_DIR)/exp/$(am__dirstamp)
$(CORE_MATH_DIR)/exp/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/exp/$(DEPDIR)
	@: > $(CORE_MATH_DIR)/exp/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/exp/libgaolcoremath_la-exp.lo:  \
	$(CORE_MATH_DIR)/exp/$(am__dirstamp) \
	$(CORE_MATH_DIR)/exp/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/log/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/log
	@: > $(CORE_MATH_DIR)/log/$(am__dirstamp)
$(CORE_MATH_DIR)/log/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/log/$(DEPDIR)
	@: > $(CORE_MATH_DIR)/log/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/log/libgaolcoremath_la-log.lo:  \
	$(CORE_MATH_DIR)/log/$(am__dirstamp) \
	$(CORE_MATH_DIR)/log/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/pow/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/pow
	@: > $(CORE_MATH_DIR)/pow/$(am__dirstamp)
$(CORE_MATH_DIR)/pow/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/pow/$(DEPDIR)
	@: > $(CORE_MATH_DIR)/pow/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/pow/libgaolcoremath_la-pow.lo:  \
	$(CORE_MATH_DIR)/pow/$(am__dirstamp) \
	$(CORE_MATH_DIR)/pow/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/sin/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/sin
	@: > $(CORE_MATH_DIR)/sin/$(am__dirstamp)
$(CORE_MATH_DIR)/sin/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) $(CORE_MATH_DIR)/sin/$(DEPDIR)
	@: > $(CORE_MATH_DIR)/sin/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/sin/libgaolcoremath_la-sin.lo:  \
	$(CORE_MATH_DIR)/sin/$(am__dirstamp) \
	$(CORE_MATH_DIR)/sin/$(DEPDIR)/$(am__dirstamp)
$(CORE_MATH_DIR)/cos/$(am__dirstamp):
