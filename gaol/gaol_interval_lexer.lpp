/*
  The following 'namespace' statement must appear before including
  gaol/gaol_interval_parser.h
 */
using namespace gaol;
using namespace gaol_core;

#include "gaol/gaol_interval_parser.h"
#include "gaol/gaol_exact.h"
#include "gaol/gaol_fpu.h"

#define YY_NEVER_INTERACTIVE 1
// The function of a name, in the table of the names the string is read with,
// which the context of the reading gives (gaol/gaol_interval_parser.ypp); 0
// for a name that is not in it
extern const void *gaol_lookup_function(const char *name, void *context);

/*
  Numbers are read exactly, whatever the C library. A number no double is
  exactly is represented by the tightest interval of doubles enclosing it.
  GAOL read it with strtod() rounding downward then upward, and told it from a
  double by the inexact flag strtod() raised; it read integers rounded to
  nearest. Not every C library rounds strtod() in the rounding direction and
  raises the flag: the C runtime of Windows, with Visual C++ or MinGW, and musl
  on 64-bit ARM processors round to nearest whatever the direction and raise no
  flag, so that "0.1" was read as the double nearest to 1/10, which does not
  enclose it. strtod() now gives a double near the number, which the number is
  compared with exactly, as integers, to find the doubles on each side of it.
  strtod() reads the decimal point of the C locale: under a locale writing a
  decimal comma, it stops at the '.' of "0.1" and gives 0, far from the
  number. The doubles on each side of it are then found by steps doubling
  from that double, and by bisection on the bits of the doubles (GAOL v5).
  The number is compared with each double taken apart by its bits, so that
  denormals-are-zero, where a subnormal is 0 in a comparison, changes nothing
  (GAOL v5). The text is taken apart once, and not by each of the comparisons
  (about 125 under such a locale), which read a long number in a time
  quadratic in its length (GAOL v5).
*/
namespace {

  // A natural number, as digits in base 2^32, least significant first, with no
  // leading zero digit (0 has no digit)
  typedef std::vector<uint32_t> gaol_natural;

  // n = n*m + a, with m > 0
  void gaol_natural_mul_add(gaol_natural& n, uint32_t m, uint32_t a)
  {
    uint64_t carry = a;
    for (std::size_t i = 0; i < n.size(); ++i) {
      const uint64_t t = static_cast<uint64_t>(n[i])*m + carry;
      n[i] = static_cast<uint32_t>(t);
      carry = t >> 32;
    }
    if (carry != 0) {
      n.push_back(static_cast<uint32_t>(carry));
    }
  }

  // n = n*5^e, with e >= 0
  void gaol_natural_mul_pow5(gaol_natural& n, long e)
  {
    for (; e >= 13; e -= 13) {
      gaol_natural_mul_add(n, 1220703125u, 0); // 5^13
    }
    uint32_t m = 1;
    for (; e > 0; --e) {
      m *= 5;
    }
    gaol_natural_mul_add(n, m, 0);
  }

  // n = n*2^e, with e >= 0
  void gaol_natural_shift_left(gaol_natural& n, long e)
  {
    if (n.empty()) {
      return;
    }
    const unsigned int bits = static_cast<unsigned int>(e % 32);
    if (bits != 0) {
      uint32_t carry = 0;
      for (std::size_t i = 0; i < n.size(); ++i) {
        const uint32_t d = n[i];
        n[i] = (d << bits) | carry;
        carry = d >> (32 - bits);
      }
      if (carry != 0) {
        n.push_back(carry);
      }
    }
    n.insert(n.begin(), static_cast<std::size_t>(e / 32), 0u);
  }

  // n*m, with m an integer of 64 bits at most
  gaol_natural gaol_natural_mul_u64(const gaol_natural& n, uint64_t m)
  {
    gaol_natural r;
    if (n.empty() || m == 0) {
      return r;
    }
    r.assign(n.size() + 2, 0u);
    for (std::size_t j = 0; j < 2; ++j) { // The two digits of m, in base 2^32
      const uint64_t mj = (j == 0) ? (m & 0xffffffffu) : (m >> 32);
      uint64_t carry = 0;
      for (std::size_t i = 0; i < n.size(); ++i) {
        // At most (2^32 - 1)^2 + 2(2^32 - 1) = 2^64 - 1
        const uint64_t t = static_cast<uint64_t>(n[i])*mj + r[i + j] + carry;
        r[i + j] = static_cast<uint32_t>(t);
        carry = t >> 32;
      }
      r[n.size() + j] = static_cast<uint32_t>(carry);
    }
    while (r.back() == 0) { // No leading zero digit, as gaol_natural_compare() needs
      r.pop_back();
    }
    return r;
  }

  // The sign of a - b
  int gaol_natural_compare(const gaol_natural& a, const gaol_natural& b)
  {
    if (a.size() != b.size()) {
      return (a.size() < b.size()) ? -1 : 1;
    }
    for (std::size_t i = a.size(); i-- > 0; ) {
      if (a[i] != b[i]) {
        return (a[i] < b[i]) ? -1 : 1;
      }
    }
    return 0;
  }

  /*
    The bound an exponent is kept at in a number of the text s: beyond it, the
    number is above the largest double or below the least positive one,
    whatever its digits. A significand that is not 0, of fewer than L digits,
    fewer than L of them after its point, L being the length of s, times 10^e
    lies between 10^(e - L) and 10^(e + L); in hexadecimal, times 2^e, between
    2^(e - 4L) and 2^(e + 4L). An exponent beyond 4L + 2000, or below its
    opposite, thus puts the number beyond the doubles, and so does the bound.
    GAOL kept exponents below 100000, which is not beyond the doubles when the
    significand has a million zeros after its point: "0." followed by a
    million zeros then "1e1000001", which is 1, was compared as 10^-900001
    (GAOL v5).
  */
  long long gaol_exponent_bound(const char *s)
  {
    return 4*static_cast<long long>(std::strlen(s)) + 2000;
  }

  // The bits of a double, and the double of given bits: the doubles of
  // [0, +oo] are ordered as their bits, read as unsigned integers
  uint64_t gaol_bits_of(double x)
  {
    uint64_t bits;
    std::memcpy(&bits, &x, sizeof bits);
    return bits;
  }

  double gaol_double_of(uint64_t bits)
  {
    double x;
    std::memcpy(&x, &bits, sizeof x);
    return x;
  }

  /*
    A number v, as the rules below match numbers (decimal digits with an
    optional point and exponent, or, after 0x, hexadecimal digits with an
    optional point and a binary exponent), taken apart once to be compared
    with doubles (GAOL v5): gaol_enclose_number() compares a number with up to
    about 125 of them, and each comparison read the text again, in a time
    quadratic in its length. It took 2.5 s for 20000 characters under a locale
    writing a decimal comma, where strtod() is far from the number, against
    0.08 s under the C locale, which needs two comparisons; both now take
    about 0.03 s (Intel i7-1185G7, GCC 9.4).
    v = N*10^k*2^k2 = N*5^k*2^(k+k2), N being an integer, is compared with a
    double x = M*2^e as N*5^k*2^(k+k2) with M*2^e, and what does not depend on
    x is kept: N*5^k for k >= 0, N and 5^-k otherwise. A comparison then costs
    the product of 5^-k by M, a shift and a comparison of integers, in a time
    linear in the length of the text.
  */
  struct gaol_number
  {
    bool is_zero;         // v = 0
    int beyond;           // -1 if v is not 0 and below the least positive double, +1 if above the largest, 0 otherwise
    long kb;              // k + k2
    gaol_natural scaled;  // N*5^k if k >= 0, N otherwise
    gaol_natural pow5;    // 5^-k if k < 0, no digit otherwise

    gaol_number() : is_zero(true), beyond(0), kb(0) {}
  };

  // The number s writes, taken apart
  gaol_number gaol_take_apart(const char *s)
  {
    // v = N*10^k*2^k2, N being written with ndigits digits
    gaol_natural N;
    long k = 0, k2 = 0, ndigits = 0;
    const long long exponent_bound = gaol_exponent_bound(s);
    const bool hexadecimal = (s[0] == '0' && (s[1] == 'x' || s[1] == 'X'));
    const uint32_t base = hexadecimal ? 16 : 10;
    if (hexadecimal) {
      s += 2;
    }
    bool fraction = false;
    for (; *s != '\0' && (hexadecimal ? (*s != 'p' && *s != 'P') : (*s != 'e' && *s != 'E')); ++s) {
      if (*s == '.') {
        fraction = true;
        continue;
      }
      const uint32_t digit = static_cast<uint32_t>((*s >= '0' && *s <= '9') ? *s - '0'
                                                   : ((*s | 0x20) - 'a' + 10));
      if (ndigits != 0 || digit != 0) {
        gaol_natural_mul_add(N, base, digit);
        ++ndigits;
      }
      if (fraction) {
        if (hexadecimal) {
          k2 -= 4;
        } else {
          --k;
        }
      }
    }
    if (*s != '\0') { // Exponent
      ++s;
      const bool negative = (*s == '-');
      if (*s == '-' || *s == '+') {
        ++s;
      }
      long long e = 0;
      for (; *s != '\0'; ++s) {
        if (e <= exponent_bound) {
          e = 10*e + (*s - '0');
        }
      }
      if (e > exponent_bound) {
        e = exponent_bound;
      }
      (hexadecimal ? k2 : k) += static_cast<long>(negative ? -e : e);
    }

    gaol_number v;
    v.is_zero = N.empty();
    if (v.is_zero) {
      return v;
    }
    // 10^(k+ndigits-1) <= v < 10^(k+ndigits), respectively
    // 2^(k2+4(ndigits-1)) <= v < 2^(k2+4 ndigits), far above the largest
    // double or below the least positive one
    if (hexadecimal ? k2 + 4*(ndigits - 1) > 1025 : k + ndigits - 1 > 310) {
      v.beyond = 1;
      return v;
    }
    if (hexadecimal ? k2 + 4*ndigits < -1080 : k + ndigits < -330) {
      v.beyond = -1;
      return v;
    }
    v.kb = k + k2;
    v.scaled.swap(N);
    if (k >= 0) {
      gaol_natural_mul_pow5(v.scaled, k);
    } else {
      v.pow5.push_back(1u);
      gaol_natural_mul_pow5(v.pow5, -k);
    }
    return v;
  }

  /*
    The sign of v - x, v being a number taken apart, and x a double.
    x is taken apart by its bits, and never compared nor decomposed as a
    double (GAOL v5): with denormals-are-zero, which programs linked with
    -Ofast have (crtfastmath.o) and the code they load can set, the
    comparisons of a subnormal with 0 and std::frexp() see it as 0. GAOL then
    took every subnormal for 0, so that "1e-310" was above all of them and was
    read as the interval from the greatest subnormal to the least normal
    double, which does not enclose it, and "0" as the greatest subnormal.
  */
  int gaol_compare_number(const gaol_number& v, double x)
  {
    const uint64_t bits = gaol_bits_of(x);
    const uint64_t plus_infinity = gaol_bits_of(std::numeric_limits<double>::infinity());
    const bool zero = ((bits << 1) == 0); // +0 or -0
    // 0 < x <= +oo: the bits of a negative number and of a NaN are above those of +oo
    const bool positive = (!zero && bits <= plus_infinity);
    if (v.is_zero) { // v = 0
      return zero ? 0 : (positive ? -1 : 1);
    }
    if (!positive) {
      return 1;
    }
    if (bits == plus_infinity) { // v is below +oo
      return -1;
    }
    if (v.beyond != 0) {
      return v.beyond;
    }

    // x = M*2^e, M being an integer of 53 bits at most: the 52 bits of the
    // fraction of x, and 2^52 more for a normal double, whose leading bit they
    // leave out; a subnormal has none, and the exponent -1074 of its unit, the
    // least positive double
    const uint64_t biased_exponent = bits >> 52; // The sign bit is 0
    uint64_t M = bits & 0x000fffffffffffffull;
    long e = -1074;
    if (biased_exponent != 0) {
      M |= 0x0010000000000000ull;
      e = static_cast<long>(biased_exponent) - 1075;
    }

    // N*5^k*2^(k+k2) compared with M*2^e
    gaol_natural A(v.scaled), B;
    if (v.pow5.empty()) {
      B.push_back(static_cast<uint32_t>(M));
      if ((M >> 32) != 0) { // No leading zero digit, as gaol_natural_compare() needs
        B.push_back(static_cast<uint32_t>(M >> 32));
      }
    } else {
      B = gaol_natural_mul_u64(v.pow5, M);
    }
    if (v.kb >= e) {
      gaol_natural_shift_left(A, v.kb - e);
    } else {
      gaol_natural_shift_left(B, e - v.kb);
    }
    return gaol_natural_compare(A, B);
  }

  /*
    The tightest interval of doubles [l, r] enclosing the number s, with no
    sign; returns whether s is a double, l and r being it.
    The greatest double lo not above the number, and the next one hi, are
    bracketed by steps doubling from the double strtod() gives, then found by
    bisection on the bits: two comparisons when strtod() gives the nearest
    double, at most about 125 whatever it gives (GAOL v5). GAOL moved one
    double at a time from it: under a locale writing a decimal comma, where
    strtod("0.1") is 0, it had about 4.6e18 doubles to go through, and the
    reading never ended. The text is taken apart once for all the
    comparisons, so that the time of a reading under such a locale is that of
    a reading under the C locale, whatever the length of the number (GAOL v5).
  */
  bool gaol_enclose_number(const char *s, double& l, double& r)
  {
    const gaol_number v = gaol_take_apart(s); // Before the rounding mode changes
    // The guard, rather than GAOL_RND_PRESERVE() and GAOL_RND_RESTORE(): the
    // comparisons of the number allocate (std::vector, std::string), and a
    // failed allocation left the direction to nearest (GAOL v5)
    const rounding_guard rnd;
    round_nearest();
    const uint64_t guess = gaol_bits_of(strtod(s,NULL)); // in [0, +oo]
    const uint64_t top = gaol_bits_of(std::numeric_limits<double>::infinity());
    // gaol_double_of(lo) <= the number < gaol_double_of(hi), sign_lo being
    // the comparison of the number with gaol_double_of(lo)
    uint64_t lo, hi;
    int sign_lo = gaol_compare_number(v, gaol_double_of(guess));
    if (sign_lo >= 0) {
      lo = guess;
      for (uint64_t step = 1;; step *= 2) {
        hi = (top - lo > step) ? lo + step : top;
        if (hi == top) { // +oo is above every number
          break;
        }
        const int sign_hi = gaol_compare_number(v, gaol_double_of(hi));
        if (sign_hi < 0) {
          break;
        }
        lo = hi;
        sign_lo = sign_hi;
      }
    } else {
      hi = guess;
      for (uint64_t step = 1;; step *= 2) {
        lo = (hi > step) ? hi - step : 0;
        sign_lo = gaol_compare_number(v, gaol_double_of(lo));
        if (sign_lo >= 0) { // at the latest for 0, which no number is below
          break;
        }
        hi = lo;
      }
    }
    while (hi - lo > 1) {
      const uint64_t middle = lo + (hi - lo)/2;
      const int sign_middle = gaol_compare_number(v, gaol_double_of(middle));
      if (sign_middle >= 0) {
        lo = middle;
        sign_lo = sign_middle;
      } else {
        hi = middle;
      }
    }
    // The direction is set back when the guard is destroyed, at the return
    l = gaol_double_of(lo);
    r = (sign_lo == 0) ? l : gaol_double_of(hi);
    return sign_lo == 0;
  }

  // Reads the number s: returns NUMBER, with lval->d set to it, if it is a
  // double, and INTERVAL_CST, with lval->itv set to the tightest interval of
  // doubles enclosing it, otherwise
  int gaol_read_number(const char *s, YYSTYPE *lval)
  {
    double l, r;
    if (gaol_enclose_number(s, l, r)) {
      lval->d = l;
      return NUMBER;
    }
    (lval->itv).l = l;
    (lval->itv).r = r;
    return INTERVAL_CST;
  }

  // Natural numbers written in decimal, most significant digit first
  std::string gaol_decimal_strip(const std::string& a)
  {
    const std::size_t i = a.find_first_not_of('0');
    return (i == std::string::npos) ? std::string("0") : a.substr(i);
  }

  // The sign of a - b
  int gaol_decimal_compare(const std::string& a, const std::string& b)
  {
    const std::string sa = gaol_decimal_strip(a), sb = gaol_decimal_strip(b);
    if (sa.size() != sb.size()) {
      return (sa.size() < sb.size()) ? -1 : 1;
    }
    return (sa < sb) ? -1 : ((sa > sb) ? 1 : 0);
  }

  // a + b, or a - b with a >= b
  std::string gaol_decimal_add_sub(const std::string& a, const std::string& b, bool subtract)
  {
    std::string res;
    int carry = 0;
    for (std::size_t i = 0; i < a.size() || i < b.size() || carry != 0; ++i) {
      const int da = (i < a.size()) ? a[a.size() - 1 - i] - '0' : 0;
      const int db = (i < b.size()) ? b[b.size() - 1 - i] - '0' : 0;
      int d = subtract ? da - db - carry : da + db + carry;
      carry = 0;
      if (d < 0) {
        d += 10;
        carry = 1;
      } else if (d > 9) {
        d -= 10;
        carry = 1;
      }
      res.insert(res.begin(), static_cast<char>('0' + d));
    }
    return gaol_decimal_strip(res);
  }

  // A signed decimal integer: its sign and its magnitude
  struct gaol_decimal
  {
    bool negative;
    std::string magnitude;
  };

  // a + b, for signed decimal integers
  gaol_decimal gaol_decimal_add(const gaol_decimal& a, const gaol_decimal& b)
  {
    gaol_decimal res;
    if (a.negative == b.negative) {
      res.negative = a.negative;
      res.magnitude = gaol_decimal_add_sub(a.magnitude, b.magnitude, false);
    } else if (gaol_decimal_compare(a.magnitude, b.magnitude) >= 0) {
      res.negative = a.negative;
      res.magnitude = gaol_decimal_add_sub(a.magnitude, b.magnitude, true);
    } else {
      res.negative = b.negative;
      res.magnitude = gaol_decimal_add_sub(b.magnitude, a.magnitude, true);
    }
    return res;
  }

  // The tightest interval of doubles [l, r] enclosing a*10^q
  void gaol_enclose_decimal(const gaol_decimal& a, long q, double& l, double& r)
  {
    const std::string s = a.magnitude + "e" + std::to_string(q);
    double lo, hi;
    gaol_enclose_number(s.c_str(), lo, hi);
    if (a.negative) {
      l = -hi;
      r = -lo;
    } else {
      l = lo;
      r = hi;
    }
  }

  /*
    Reads a number in the uncertain form of IEEE 1788-2015 (9.7.4, 12.11.3,
    GAOL v5): m?rve, m being a decimal number with an optional sign, r a
    natural number of units of the last place of m (half a unit when absent)
    or ?, for an infinite radius, v the direction d or u, and e an exponent
    written as e and an integer. Returns UNCERTAIN_CST, with lval->itv set
    to the tightest interval of doubles enclosing the interval the number
    denotes: [m-r, m+r] times 10^e, [m-r, m] for d, [m, m+r] for u.
  */
  int gaol_read_uncertain(const char *s, YYSTYPE *lval)
  {
    const long long exponent_bound = gaol_exponent_bound(s);
    gaol_decimal m;
    m.negative = (*s == '-');
    if (*s == '-' || *s == '+') {
      ++s;
    }
    long places = 0; // Digits after the point
    bool fraction = false;
    for (; *s != '?'; ++s) {
      if (*s == '.') {
        fraction = true;
        continue;
      }
      m.magnitude += *s;
      if (fraction) {
        ++places;
      }
    }
    ++s; // '?'
    bool infinite = false;
    std::string radius;
    if (*s == '?') {
      infinite = true;
      ++s;
    } else {
      for (; *s >= '0' && *s <= '9'; ++s) {
        radius += *s;
      }
    }
    char direction = 0;
    if (*s == 'd' || *s == 'D' || *s == 'u' || *s == 'U') {
      direction = static_cast<char>(*s | 0x20);
      ++s;
    }
    long exponent = 0;
    if (*s == 'e' || *s == 'E') {
      ++s;
      const bool negative = (*s == '-');
      if (*s == '-' || *s == '+') {
        ++s;
      }
      long long e = 0;
      for (; *s != '\0'; ++s) {
        if (e <= exponent_bound) {
          e = 10*e + (*s - '0');
        }
      }
      exponent = static_cast<long>((e > exponent_bound) ? exponent_bound : e);
      if (negative) {
        exponent = -exponent;
      }
    }
    m.magnitude = gaol_decimal_strip(m.magnitude);

    double l, r;
    if (infinite) {
      // m??d is [-oo, m], m??u is [m, +oo], m?? is [-oo, +oo]
      double ml, mr;
      gaol_enclose_decimal(m, exponent - places, ml, mr);
      l = (direction == 'u') ? ml : -GAOL_INFINITY;
      r = (direction == 'd') ? mr : GAOL_INFINITY;
    } else {
      // With one more decimal place, m and the radius are integers: 10m and
      // 10r, or 5 for half a unit
      gaol_decimal m10 = m, r10, minus_r10;
      m10.magnitude += "0";
      r10.negative = false;
      r10.magnitude = radius.empty() ? std::string("5") : radius + "0";
      minus_r10.negative = true;
      minus_r10.magnitude = r10.magnitude;
      const long q = exponent - places - 1;
      double lo, hi;
      gaol_enclose_decimal((direction == 'u') ? m10 : gaol_decimal_add(m10, minus_r10), q, l, hi);
      gaol_enclose_decimal((direction == 'd') ? m10 : gaol_decimal_add(m10, r10), q, lo, r);
    }
    (lval->itv).l = l;
    (lval->itv).r = r;
    return UNCERTAIN_CST;
  }

}

namespace gaol {
  // The sign of v - x, v being the number s writes, with no sign, and x a
  // double, compared exactly: for the output of intervals (gaol_interval.cpp),
  // whose decimal bounds are rounded outward whatever the C library
  int compare_number_with_double(const char *s, double x)
  {
    return gaol_compare_number(gaol_take_apart(s), x);
  }
}
%}

%top{
/* <stdint.h> before the code of flex, which defines INT8_MIN and the other
   limits of integer types where <stdint.h> has not defined them: the
   <stdint.h> of Visual C++, which the prologue includes after that code,
   redefined them (warning C4005). */
#include <stdint.h>
}

/* yyunput() and yyinput() are not used. The case of letters is ignored, as
   IEEE 1788-2015 has it for literals (9.7.1): [Empty], [1, Inf] and 1E3 are
   read (GAOL v5). No default rule: a newline, which the rule . does not take
   and SPACE did not, fell to the one of flex, which wrote it on the standard
   output and read on (GAOL v5); a newline is now a space. */
%option nounput noinput caseless nodefault

/* A reentrant scanner, whose state is in a structure of its own rather than
   in globals, and which gives the value of a token through the pointer the
   pure parser passes it (bison-bridge): each reading of a string has its own
   scanner, and several threads read strings at once (GAOL v5). Its extra data
   is the context of the reading (gaol/gaol_interval_parser.ypp), which holds
   the names of the functions. No yywrap(): a string is read to its end. */
%option reentrant bison-bridge noyywrap

DIGIT		[0-9]
HEXDIGIT	[0-9a-f]
INT		{DIGIT}+
E 		e[+-]?{DIGIT}+
DECSIGNIFICAND	{DIGIT}*"."{DIGIT}+|{DIGIT}+"."?
SPACE		[ \t\r\n]+

%%

"empty"		{ return EMPTY_STR; }
"entire"	{ return ENTIRE_STR; }
"inf"		{ return INFINITY_STR; }
"infinity"	{ return INFINITY_STR; }
"pi"		{ return PI_STR; }
"dmin"                     { return DMIN_STR; }
"dmax"                    { return DMAX_STR; }
[a-z_][a-z0-9_]*	{ /* The name of a function, looked for in the table of the
			     names the string is read with, those of GAOL or those
			     of IEEE 1788-2015 (gaol_lookup_function() in
			     gaol/gaol_interval_parser.ypp): a name that is not in
			     it is an error. The names above, which are no
			     functions, come first (GAOL v5) */
			  yylval->fn = gaol_lookup_function(yytext, yyextra);
			  return yylval->fn ? FUNCTION_NAME : UNEXPECTED_CHAR; }
"["		{ return '['; }
"]"		{ return ']'; }
"<"		{ return '<'; }
">"		{ return '>'; }
"("		{ return '('; }
")"		{ return ')'; }
","		{ return ','; }
"+"		{ return '+'; }
"-"		{ return '-'; }
"*"		{ return '*'; }
"/"		{ return '/'; }

{INT} |
{DIGIT}+{E} |
{DIGIT}*"."{DIGIT}+({E})? |
{DIGIT}+"."{DIGIT}*({E})?	{ return gaol_read_number(yytext, yylval); }
0x({HEXDIGIT}*"."{HEXDIGIT}+|{HEXDIGIT}+"."?)p[+-]?{DIGIT}+	{ return gaol_read_number(yytext, yylval); }
[+-]?({DECSIGNIFICAND})"?"({DIGIT}+|"?")?[du]?({E})?	{ return gaol_read_uncertain(yytext, yylval); }
{SPACE}		{  }
.		{ return UNEXPECTED_CHAR; /* Just to avoid stopping here */ }
%%

/*
  The scanner of a reading of the string s, whose extra data is the context of
  the reading; 0 if it could not be allocated. gaol_cleanup_parsing() frees it,
  with its buffer (GAOL v5)
*/
void *gaol_initialize_parsing(const char *const s, void *context)
{
  yyscan_t scanner;
  if (gaol_lex_init_extra(context, &scanner) != 0) {
    return 0;
  }
  gaol__scan_string(s, scanner);
  return scanner;
}

void gaol_cleanup_parsing(void *scanner)
{
  gaol_lex_destroy(scanner);
}
