#include <cstdarg>
#include <cstdlib>
#include <cmath>
#include <exception>
#include <string>
#include "gaol/gaol_common.h"
#include "gaol/gaol_interval.h"
#include "gaol/gaol_expression.h"
#include "gaol/gaol_expr_eval.h"
#include "gaol/gaol_limits.h"
#include "gaol/gaol_exceptions.h"

#undef yyerror
#define yyerror gaol_error_bison

int gaol_error_bison(const char *s ...);
int gaol_lex(void);

using namespace gaol;
extern interval *gaol_result_of_parsing;
extern bool gaol_global_parsing_flag;

/*
  One grammar, whose every string is an expression (GAOL v5)

  GAOL read a string with two grammars: the numbers, the constants and the
  functions of them built the tree of gaol/gaol_expression.h, while the
  intervals written between brackets, and the operations on them, were
  computed at once. Bison chose between the two at each token (124
  shift/reduce and 14 reduce/reduce conflicts): once a number had started the
  tree, no interval could come, and 1+[1,2], 2*cos([0,1]) and [1,2]+1+[1,2]
  were refused while [1,2]*2 was read, as was an interval in a bound,
  [cos([0,1]), 2]. Each literal set the flag of success, which the next one
  set again: [nth_root(8,1.5)]+[1,2] gave [-oo,+oo] rather than an error.

  The literals of intervals, the uncertain numbers, empty and <a,b> are now
  leaves of the tree, computed when they are read, and the operators and
  functions are nodes over any expression. The grammar has no conflict, and an
  error found in an action aborts the parsing at once.
*/

/*
  The parser holds one reference to each node it builds (gaol_node()), which
  it gives up when the node goes into another node, which holds its own, or
  when its value has been computed (GAOL v5): GAOL kept it, and the nodes of
  every expression read were never freed.
*/
static expr_node *gaol_node(expr_node *e)
{
  e->inc_refcount();
  return e;
}

static void gaol_release(expr_node *e)
{
  if (e->dec_refcount() == 0) {
    delete e;
  }
}

/*
  The value of the tree e: a literal, a bound, the exponent of nth_root(). The
  parser builds no null node, the only one whose evaluation fails.
*/
static interval gaol_value(expr_node *e)
{
  expr_eval eval;
  e->accept(eval);
  return eval.result();
}

/*
  The exception an action raises (GAOL v5): the action keeps it and aborts,
  the parser frees the nodes it holds, and parse_interval() throws it again.
  Thrown through the parser, it left them.
*/
std::exception_ptr gaol_parsing_exception;

#define GAOL_PARSING_ERROR(excep,msg)                                   \
  do {                                                                  \
    try {                                                               \
      gaol_ERROR(excep,msg);                                            \
    } catch (...) {                                                     \
      gaol_parsing_exception = std::current_exception();                \
    }                                                                   \
  } while (0)

/*
  1 if e is the infinity written inf, -1 if it is -inf, 0 otherwise (GAOL
  v5). An infinity read in an expression is [dmax, +oo] or [-oo, -dmax] (see
  gaol_expr_eval.h), but a lower bound written inf, or an upper bound written
  -inf, leaves no interval, as numsToInterval of IEEE 1788-2015 (10.5.8): [inf],
  [inf, inf] and [inf,] are the empty set.
*/
static int gaol_literal_infinity(expr_node *e)
{
  if (double_node *d = dynamic_cast<double_node*>(e)) {
    return (d->get_val() == GAOL_INFINITY) ? 1 : ((d->get_val() == -GAOL_INFINITY) ? -1 : 0);
  }
  if (unary_minus_node *m = dynamic_cast<unary_minus_node*>(e)) {
    return -gaol_literal_infinity(m->get_subexpr());
  }
  return 0;
}

// The leaf holding the interval of a literal
static expr_node *gaol_leaf(const interval& I)
{
  return gaol_node(new interval_node(I));
}

/*
  The leaf of an uncertain number, 3.56?1 (GAOL v5). IEEE 1788-2015 makes the
  uncertain form an interval literal of its own, not a number that can bound
  one: [5?1] is no interval literal (12.11.4). Its leaf is told apart from
  the other intervals so that the literals between brackets refuse it.
*/
class uncertain_node : public interval_node {
public:
  explicit uncertain_node(const interval& I) : interval_node(I) {}
};

// e is an uncertain number, alone or behind a minus sign
static bool gaol_uncertain(expr_node *e)
{
  if (unary_minus_node *m = dynamic_cast<unary_minus_node*>(e)) {
    return gaol_uncertain(m->get_subexpr());
  }
  return dynamic_cast<uncertain_node*>(e) != 0;
}

// e is an uncertain number written as a bound: the error the parsing aborts with
static bool gaol_uncertain_bound(expr_node *e)
{
  if (!gaol_uncertain(e)) {
    return false;
  }
  GAOL_PARSING_ERROR(input_format_error,
    "an uncertain number is no bound of an interval literal (IEEE 1788-2015, 12.11)");
  return true;
}
%}

%union {
  int i;
  double d;
  Interval_struct itv;
  expr_node* expr;
}


%token EMPTY_STR ENTIRE_STR INFINITY_STR DMIN_STR DMAX_STR PI_STR
%token EXP_STR LOG_STR POW_STR NTH_ROOT_STR SQRT_STR
/* The functions GAOL v5 adds to the reader: the exponential and the
   logarithm in base 2, the cube root, and two of the integer functions of
   IEEE 1788-2015 (Table 9.1) */
%token EXP2_STR LOG2_STR CBRT_STR SIGN_STR TRUNC_STR
%token COS_STR SIN_STR TAN_STR ATAN2_STR
%token COSH_STR SINH_STR TANH_STR
%token ACOS_STR ASIN_STR ATAN_STR
%token ACOSH_STR ASINH_STR ATANH_STR
%token UNEXPECTED_CHAR
%token<d> NUMBER
%token<itv> INTERVAL_CST UNCERTAIN_CST

%type<expr> expression literal function_call

/* The nodes the parser discards on a syntax error (GAOL v5). The symbols
   are named, rather than <expr>, which Bison 2.3 of macOS does not read */
%destructor { gaol_release($$); } expression literal function_call

%left '+' '-'
%left '*' '/'
%left UMINUS UPLUS

%start itv_expr

%%

itv_expr
	: expression					{ *gaol_result_of_parsing = gaol_value($1);
							  gaol_release($1);
							  gaol_global_parsing_flag = true; }
	;

expression
	: NUMBER					{ $$ = gaol_node(new double_node($1)); }
	| DMIN_STR					{ $$ = gaol_node(new double_node(std::numeric_limits<double>::min())); }
	| DMAX_STR					{ $$ = gaol_node(new double_node(std::numeric_limits<double>::max())); }
	| INFINITY_STR					{ $$ = gaol_node(new double_node(GAOL_INFINITY)); }
	| PI_STR					{ $$ = gaol_leaf(interval::pi()); }
	| INTERVAL_CST					{ $$ = gaol_leaf(interval($1.l,$1.r)); }
	| UNCERTAIN_CST					{ $$ = gaol_node(new uncertain_node(interval($1.l,$1.r))); }
	| EMPTY_STR					{ $$ = gaol_leaf(interval::emptyset()); }
	| literal					{ $$ = $1; }
	| expression '+' expression			{ $$ = gaol_node(new add_node(*$1,*$3));
							  gaol_release($1); gaol_release($3); }
	| expression '-' expression			{ $$ = gaol_node(new sub_node(*$1,*$3));
							  gaol_release($1); gaol_release($3); }
	| expression '*' expression			{ $$ = gaol_node(new mult_node(*$1,*$3));
							  gaol_release($1); gaol_release($3); }
	| expression '/' expression			{ $$ = gaol_node(new div_node(*$1,*$3));
							  gaol_release($1); gaol_release($3); }
	| '-' expression %prec UMINUS			{ $$ = gaol_node(new unary_minus_node(*$2));
							  gaol_release($2); }
	| '+' expression %prec UPLUS			{ $$ = $2; }
	| function_call					{ $$ = $1; }
	| '(' expression ')'				{ $$ = $2; }
	;

/* The literals of intervals, with their bounds computed when they are read.
   Those of IEEE 1788-2015 (12.11.3): [ ] is the empty set, [entire] and [,]
   are [-oo, +oo], and a bound left out is infinite. <a,b> is the interval
   [a,b] whose bounds have to be the same double. No bound is an uncertain
   number, which is an interval literal of its own (12.11.4). */
literal
	: '[' expression ']'				{ if (gaol_uncertain_bound($2)) {
							    gaol_release($2);
							    YYABORT;
							  }
							  const interval v = gaol_value($2);
							  const bool infinite = (gaol_literal_infinity($2) != 0);
							  gaol_release($2);
							  $$ = gaol_leaf(infinite ? interval::emptyset() : v); }
	| '[' expression ',' expression ']'		{ if (gaol_uncertain_bound($2) || gaol_uncertain_bound($4)) {
							    gaol_release($2); gaol_release($4);
							    YYABORT;
							  }
							  const interval l = gaol_value($2), r = gaol_value($4);
							  const bool infinite = (gaol_literal_infinity($2) > 0
										 || gaol_literal_infinity($4) < 0);
							  gaol_release($2); gaol_release($4);
							  $$ = gaol_leaf(infinite ? interval::emptyset()
									 : interval(l.left(),r.right())); }
	| '[' ']'					{ $$ = gaol_leaf(interval::emptyset()); }
	| '[' ENTIRE_STR ']'				{ $$ = gaol_leaf(interval::universe()); }
	| '[' ',' ']'					{ $$ = gaol_leaf(interval::universe()); }
	| '[' expression ',' ']'			{ if (gaol_uncertain_bound($2)) {
							    gaol_release($2);
							    YYABORT;
							  }
							  const interval l = gaol_value($2);
							  const bool infinite = (gaol_literal_infinity($2) > 0);
							  gaol_release($2);
							  $$ = gaol_leaf(infinite ? interval::emptyset()
									 : interval(l.left(),GAOL_INFINITY)); }
	| '[' ',' expression ']'			{ if (gaol_uncertain_bound($3)) {
							    gaol_release($3);
							    YYABORT;
							  }
							  const interval r = gaol_value($3);
							  const bool infinite = (gaol_literal_infinity($3) < 0);
							  gaol_release($3);
							  $$ = gaol_leaf(infinite ? interval::emptyset()
									 : interval(-GAOL_INFINITY,r.right())); }
	| '<' expression ',' expression '>'		{ if (gaol_uncertain_bound($2) || gaol_uncertain_bound($4)) {
							    gaol_release($2); gaol_release($4);
							    YYABORT;
							  }
							  const interval l = gaol_value($2), r = gaol_value($4);
							  gaol_release($2); gaol_release($4);
							  if (l.left() != r.right()) {
							    GAOL_PARSING_ERROR(input_format_error,
							      "bounds of degenerate interval do not evaluate to the same value");
							    YYABORT;
							  }
							  $$ = gaol_leaf(interval(l.left(),r.right())); }
	;

function_call
	: COS_STR '(' expression ')'			{ $$ = gaol_node(new cos_node(*$3)); gaol_release($3); }
	| SIN_STR '(' expression ')'			{ $$ = gaol_node(new sin_node(*$3)); gaol_release($3); }
	| TAN_STR '(' expression ')'			{ $$ = gaol_node(new tan_node(*$3)); gaol_release($3); }
	| ATAN2_STR '(' expression ',' expression ')'	{ $$ = gaol_node(new atan2_node(*$3,*$5));
							  gaol_release($3); gaol_release($5); }
	| ACOS_STR '(' expression ')'			{ $$ = gaol_node(new acos_node(*$3)); gaol_release($3); }
	| ASIN_STR '(' expression ')'			{ $$ = gaol_node(new asin_node(*$3)); gaol_release($3); }
	| ATAN_STR '(' expression ')'			{ $$ = gaol_node(new atan_node(*$3)); gaol_release($3); }
	| COSH_STR '(' expression ')'			{ $$ = gaol_node(new cosh_node(*$3)); gaol_release($3); }
	| SINH_STR '(' expression ')'			{ $$ = gaol_node(new sinh_node(*$3)); gaol_release($3); }
	| TANH_STR '(' expression ')'			{ $$ = gaol_node(new tanh_node(*$3)); gaol_release($3); }
	| ACOSH_STR '(' expression ')'			{ $$ = gaol_node(new acosh_node(*$3)); gaol_release($3); }
	| ASINH_STR '(' expression ')'			{ $$ = gaol_node(new asinh_node(*$3)); gaol_release($3); }
	| ATANH_STR '(' expression ')'			{ $$ = gaol_node(new atanh_node(*$3)); gaol_release($3); }
	| EXP_STR '(' expression ')'			{ $$ = gaol_node(new exp_node(*$3)); gaol_release($3); }
	| LOG_STR '(' expression ')'			{ $$ = gaol_node(new log_node(*$3)); gaol_release($3); }
	| EXP2_STR '(' expression ')'			{ $$ = gaol_node(new exp2_node(*$3)); gaol_release($3); }
	| LOG2_STR '(' expression ')'			{ $$ = gaol_node(new log2_node(*$3)); gaol_release($3); }
	| SIGN_STR '(' expression ')'			{ $$ = gaol_node(new sign_node(*$3)); gaol_release($3); }
	| TRUNC_STR '(' expression ')'			{ $$ = gaol_node(new trunc_node(*$3)); gaol_release($3); }
	/* sqrt(x) and cbrt(x) are nth_root(x, 2) and nth_root(x, 3), which
	   compute them with sqrt() and cube_root() */
	| SQRT_STR '(' expression ')'			{ $$ = gaol_node(new nth_root_node(*$3,2)); gaol_release($3); }
	| CBRT_STR '(' expression ')'			{ $$ = gaol_node(new nth_root_node(*$3,3)); gaol_release($3); }
	/* gaol::pow(x, y), gaol_pow_hybrid(), which takes gaol_pown() for an
	   exponent that is an integer: the parser took 1/x^|n| for n < 0, whose
	   x^|n| overflowed (pow(2,-1050) was [0,5.6e-309] rather than
	   [2^-1050]), and 1 for n = 0, which is no value for an empty x (GAOL
	   v5) */
	| POW_STR '(' expression ',' expression ')'	{ $$ = gaol_node(new pow_itv_node(*$3,*$5));
							  gaol_release($3); gaol_release($5); }
	/* The exponent is an int, which may be negative: rootn(x, q) of IEEE
	   1788-2015 for q < 0, 1/x^(1/|q|), as nth_root(I, int) computes it (the
	   cast to an unsigned int took the 4294967294-th root for q = -2, GAOL
	   v5). -q on a long, INT_MIN having no opposite on an int. */
	| NTH_ROOT_STR '(' expression ',' expression ')' { const interval q = gaol_value($5);
							  gaol_release($5);
							  if (!q.is_an_int()) {
							    gaol_release($3);
							    GAOL_PARSING_ERROR(invalid_action_error,
							      "nth_root used with non integral 2nd arg.");
							    YYABORT;
							  }
							  const int n = static_cast<int>(q.left());
							  if (n < 0) {
							    expr_node *one = gaol_node(new double_node(1.0));
							    expr_node *root = gaol_node(new nth_root_node(*$3,
							      static_cast<unsigned int>(-static_cast<long>(n))));
							    $$ = gaol_node(new div_node(*one,*root));
							    gaol_release(one);
							    gaol_release(root);
							  } else {
							    $$ = gaol_node(new nth_root_node(*$3,static_cast<unsigned int>(n)));
							  }
							  gaol_release($3); }
	;

%%

int gaol_error_bison(const char *s ...)
{
  gaol_global_parsing_flag = false;
  return 0; // An error occurred
}
