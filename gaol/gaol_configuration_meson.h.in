/* Copyright (c) 2026 ENSTA, France */
/* Modified by Jordan NININ (GAOL v5) */
/* gaol/gaol_configuration.h, written by meson from
   gaol/gaol_configuration_meson.h.in.

   The macros are the same with the three builds, CMake
   (cmake/gaol_configuration.h.in), configure (gaol/gaol_configuration.h.in)
   and meson (gaol/gaol_configuration_meson.h.in), and are what the build tells
   GAOL: doc/building.md lists them, and says which the sources of GAOL do not
   read. What GAOL needs to know of the processor and the system, and the
   sizes of the integer types, come from the macros of the compiler
   (gaol/gaol_config.h). Every compiler includes this header, through
   gaol/gaol_config.h. (GAOL v5) */

#ifndef GAOL_CONFIGURATION_H
#define GAOL_CONFIGURATION_H

/* The version of GAOL: 5, 0, 0 and "5.0.0" for GAOL 5.0.0 */
#mesondefine GAOL_MAJOR_VERSION
#mesondefine GAOL_MINOR_VERSION
#mesondefine GAOL_MICRO_VERSION
#mesondefine GAOL_VERSION

/* Defined to 1 by a Debug build (CMAKE_BUILD_TYPE=Debug, configure
   --enable-debug, meson --buildtype=debug): GAOL writes its debugging
   messages (GAOL_DEBUG_VERBOSE) */
#mesondefine GAOL_DEBUGGING

/* Defined to 1 to raise exceptions instead of aborting: by default with the
   three builds; -DGAOL_EXCEPTIONS_ENABLED=OFF of CMake, --disable-exceptions
   of configure and -Denable-exception=false of meson abort instead (settings of
   the developers; GAOL v5) */
#mesondefine GAOL_EXCEPTIONS_ENABLED

/* Defined to 1 to restore the rounding direction after each operation,
   rather than leaving it upward (GAOL_PRESERVE_ROUNDING,
   --enable-preserve-rounding, -Denable-preserve-rounding=true; see
   gaol/gaol_fpu.h) */
#mesondefine GAOL_PRESERVE_ROUNDING

/* Defined to 1 to write a line on the standard error when GAOL initializes
   and cleans up (-DGAOL_VERBOSE_MODE=ON of CMake, --enable-verbose-mode of
   configure, -Denable-verbose-mode=true of meson; off by default: a setting of
   the developers; GAOL v5) */
#mesondefine GAOL_VERBOSE_MODE

/* Defined to 1 where the intervals are computed with SSE2 instructions
   (x86 processors; on 32-bit Windows with GCC or Clang told to ask for aligned
   memory, -faligned-new=8, and with Visual C++ and clang-cl, whose bounds are
   two doubles there; GAOL_SIMD,
   --enable-simd, -Denable-simd, on by default) */
#mesondefine GAOL_USING_SSE2_INSTRUCTIONS

/* Defined to 1 where they are compiled with -msse3 too */
#mesondefine GAOL_USING_SSE3_INSTRUCTIONS

/* Defined to 1 where the intervals are computed with NEON instructions
   (64-bit ARM processors, with every compiler; not with 32-bit ARM;
   GAOL_SIMD, --enable-simd, -Denable-simd, on by default, as for the SSE2
   intervals) (GAOL v5: GAOL_ARM64, --enable-arm64 and -Denable-arm64 were
   options of their own, independent of GAOL_SIMD) */
#mesondefine GAOL_USING_NEON_INSTRUCTIONS

/* Defined to 1 by a universal build of macOS (several architectures in
   CMAKE_OSX_ARCHITECTURES of CMake, or -arch several times in the flags of
   configure and meson; one configuration compiled for each): SSE2 for the
   x86_64 part, where GAOL_SIMD allows it, and NEON for the arm64 part, where
   it does too. The macros above are then those of the architecture being
   compiled (GAOL v5) */
#mesondefine GAOL_UNIVERSAL_SSE2
#mesondefine GAOL_UNIVERSAL_NEON
#if defined(GAOL_UNIVERSAL_SSE2) && defined(__x86_64__)
#  define GAOL_USING_SSE2_INSTRUCTIONS 1
#  define GAOL_USING_SSE3_INSTRUCTIONS 1
#endif
#if defined(GAOL_UNIVERSAL_NEON) && defined(__aarch64__)
#  define GAOL_USING_NEON_INSTRUCTIONS 1
#endif
/* Defined to 1 where the compiler accepts the AVX-512 instructions in the
   functions that carry __attribute__((target("avx512f"))) and
   __builtin_cpu_supports("avx512f"), which the AVX-512 path of +, -, *, /,
   sqr, sqrt and, with FMA, the integer powers beyond 1 and -1
   (gaol/core/gaol_interval_avx512.cpp) needs; Visual C++ for x64 takes them in any
   function and tells the processor by cpuid (GAOL v5) */
#mesondefine GAOL_HAVE_AVX512_TARGET

/* Defined to 1 to ask for that path (GAOL_PREFER_AVX512): the build decides, on
   where GAOL_PRESERVE_ROUNDING is and off otherwise, which is what the
   measures of doc/simd.md ask for; -DGAOL_PREFER_AVX512=ON|OFF of CMake,
   --enable-prefer-avx512 and --disable-prefer-avx512 of configure,
   -Denable-prefer-avx512=true|false of meson ask otherwise (settings of the
   developers, and of the users who build a package for any processor), which
   GAOL_AVX512_ARITHMETIC below takes where it can: +, -, *, /, sqr, sqrt
   and, with FMA, the integer powers beyond 1 and -1 then set no rounding
   direction, their instructions carrying theirs and raising no exception
   flag; they clear the modes that flush the subnormals to zero, with the
   check of the other operations, which may raise the flags doc/using.md
   lists, and leave them cleared, or give them back with
   GAOL_PRESERVE_ROUNDING (GAOL v5, point Q of TODO.md) */
#mesondefine GAOL_PREFER_AVX512
/* Defined to 1 where +, -, *, /, sqr, sqrt and, with FMA, the integer powers
   beyond 1 and -1 take the AVX-512 path, which the configuration decides:
   GAOL_PREFER_AVX512, a compiler that takes the path
   (GAOL_HAVE_AVX512_TARGET), and a machine building that runs it (when
   cross-compiling no program can be run, and the path is left out unless
   GAOL_MACHINE_RUNS_AVX512 of CMake, gaol_cv_machine_runs_avx512=yes of
   configure or machine-runs-avx512 of meson says that the machine running GAOL
   runs it). The library then needs a processor with the AVX-512
   instructions, and the operations test nothing as they run (GAOL v5, point
   AA of TODO.md) */
#mesondefine GAOL_AVX512_ARITHMETIC

/* Defined to 1 where the library is compiled with -fvisibility=hidden:
   GAOL's public declarations then carry __attribute__ ((visibility("default")))
   (gaol/gaol_config.h) */
#mesondefine GAOL_HAVE_VISIBILITY_OPTIONS

/* Defined to 1 where the compiler has <fenv.h> */
#mesondefine GAOL_HAVE_FENV_H

/* The macros above that the build leaves undefined are 0 (GAOL v5, point Z
   of TODO.md): GAOL's headers read them with #if, which warned under
   -Wundef, so that a program could not include GAOL under -Wundef -Werror.
   A program reads them with #if too: #ifdef is now true of each of them.
   Keep "#  define" indented: .github/audit/probe_build.py reads the lines
   "#define" of the header, which the 0 would follow where the build writes
   the 1. */
#ifndef GAOL_DEBUGGING
#  define GAOL_DEBUGGING 0
#endif
#ifndef GAOL_EXCEPTIONS_ENABLED
#  define GAOL_EXCEPTIONS_ENABLED 0
#endif
#ifndef GAOL_PRESERVE_ROUNDING
#  define GAOL_PRESERVE_ROUNDING 0
#endif
#ifndef GAOL_VERBOSE_MODE
#  define GAOL_VERBOSE_MODE 0
#endif
#ifndef GAOL_USING_SSE2_INSTRUCTIONS
#  define GAOL_USING_SSE2_INSTRUCTIONS 0
#endif
#ifndef GAOL_USING_SSE3_INSTRUCTIONS
#  define GAOL_USING_SSE3_INSTRUCTIONS 0
#endif
#ifndef GAOL_USING_NEON_INSTRUCTIONS
#  define GAOL_USING_NEON_INSTRUCTIONS 0
#endif
#ifndef GAOL_HAVE_AVX512_TARGET
#  define GAOL_HAVE_AVX512_TARGET 0
#endif
#ifndef GAOL_PREFER_AVX512
#  define GAOL_PREFER_AVX512 0
#endif
#ifndef GAOL_AVX512_ARITHMETIC
#  define GAOL_AVX512_ARITHMETIC 0
#endif
#ifndef GAOL_HAVE_VISIBILITY_OPTIONS
#  define GAOL_HAVE_VISIBILITY_OPTIONS 0
#endif
#ifndef GAOL_HAVE_FENV_H
#  define GAOL_HAVE_FENV_H 0
#endif
#endif /* GAOL_CONFIGURATION_H */
