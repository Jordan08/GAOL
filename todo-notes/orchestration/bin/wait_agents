#!/usr/bin/env python3
"""wait_agents [minutes=9] [workflow-id ...]: returns as soon as an agent of the workflows completes
(prints it), or after the given number of minutes."""
import json, os, sys, glob, time
ROOT = "/home/jninin/.claude/projects/-home-jninin-Documents-WORK-DEV-GAOL-GAOL-V8/334ea319-d088-4702-9b10-e0628647c222/subagents/workflows"
minutes = float(sys.argv[1]) if len(sys.argv) > 1 else 9.0
wfs = sys.argv[2:]
def snapshot():
    res = {}
    for wf in (wfs or sorted(os.listdir(ROOT))):
        for meta in sorted(glob.glob(os.path.join(ROOT, wf, "agent-*.meta.json"))):
            jl = meta[:-len(".meta.json")] + ".jsonl"
            try:
                m = json.load(open(meta)); out = None
                for line in open(jl, errors="replace"):
                    try: e = json.loads(line)
                    except Exception: continue
                    c = (e.get("message") or {}).get("content")
                    if isinstance(c, list):
                        for b in c:
                            if b.get("type") == "tool_use" and b.get("name") == "StructuredOutput":
                                out = b.get("input")
                res[jl] = (wf[-8:], m.get("description"), out, (time.time() - os.path.getmtime(jl)) / 60)
            except Exception:
                pass
    return res
first = snapshot()
done0 = {k for k, v in first.items() if v[2] is not None}
end = time.time() + minutes * 60
while time.time() < end:
    time.sleep(20)
    now = snapshot()
    new = [k for k, v in now.items() if v[2] is not None and k not in done0]
    if new:
        for k in new:
            wf, d, out, _ = now[k]
            st = ""
            if isinstance(out, dict):
                st = out.get("status") or out.get("verdict") or ""
                if out.get("blocking"): st += " (%d blocking)" % len(out["blocking"])
            print("DONE %s %s: %s" % (wf, d, st))
        break
now = snapshot()
print("agents: %d running, %d done" % (sum(1 for v in now.values() if v[2] is None), sum(1 for v in now.values() if v[2] is not None)))
idle = [(v[1], round(v[3])) for v in now.values() if v[2] is None and v[3] > 15]
if idle: print("idle > 15 min:", idle)
