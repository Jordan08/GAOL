#!/usr/bin/env python3
"""agent_result <description> [workflow-id]: the StructuredOutput of the (last) agent with that description, as JSON."""
import json, os, sys, glob
ROOT = "/home/jninin/.claude/projects/-home-jninin-Documents-WORK-DEV-GAOL-GAOL-V8/334ea319-d088-4702-9b10-e0628647c222/subagents/workflows"
desc = sys.argv[1]; wfs = sys.argv[2:] or sorted(os.listdir(ROOT))
best = None
for wf in wfs:
    for meta in sorted(glob.glob(os.path.join(ROOT, wf, "agent-*.meta.json"))):
        m = json.load(open(meta))
        if m.get("description") != desc: continue
        jl = meta[:-len(".meta.json")] + ".jsonl"
        for line in open(jl, errors="replace"):
            try: e = json.loads(line)
            except Exception: continue
            c = (e.get("message") or {}).get("content")
            if isinstance(c, list):
                for b in c:
                    if b.get("type") == "tool_use" and b.get("name") == "StructuredOutput":
                        best = b.get("input")
print(json.dumps(best, indent=1, ensure_ascii=False) if best is not None else "no result yet")
