#!/usr/bin/env python3
"""conflicts <branch>...: which pairs of branches conflict when merged, and in which files
(git merge-tree of each pair over their merge-base: nothing is checked out, nothing is written).
A branch stacked on another (made from its tip) does not conflict with it."""
import subprocess, sys, itertools, re
MAIN = "/home/jninin/Documents/WORK/DEV/GAOL/GAOL_V8"
def sh(*a):
    return subprocess.run(a, cwd=MAIN, capture_output=True, text=True).stdout
branches = sys.argv[1:]
total = 0
for a, b in itertools.combinations(branches, 2):
    base = sh("git", "merge-base", a, b).strip()
    if not base:
        continue
    if base == sh("git", "rev-parse", a).strip() or base == sh("git", "rev-parse", b).strip():
        continue  # one is an ancestor of the other: a stack
    out = sh("git", "merge-tree", base, a, b)
    files = []
    for block in re.split(r"(?m)^(?=(?:added in both|changed in both|removed in local|removed in remote)\n)", out):
        if "<<<<<<<" in block:
            m = re.search(r"^\s+our\s+\d+ \w+ (\S+)", block, re.M)
            files.append(m.group(1) if m else "?")
    if files:
        total += 1
        print("%-42s x %-42s %s" % (a, b, ", ".join(files)))
print("%d conflicting pair(s) among %d branches" % (total, len(branches)))
