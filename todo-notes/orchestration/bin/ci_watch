#!/usr/bin/env python3
"""ci_watch [--baseline JOB]... [--interval 60] <branch>...

Polls the continuous integration of the branches pushed to Jordan08/GAOL and prints ONE LINE each time
something changes (a workflow run starts, completes, fails), and a summary line when every push run of
a branch has completed:

  <branch> DONE green                     every run succeeded (or only failed on a baseline job)
  <branch> DONE red: <workflow>: <jobs>   what failed and was not failing on the base commit

--list FILE reads the branches from FILE (one per line, # comments) on every round and never exits.
--baseline JOB (repeatable) names jobs that fail on the base commit (configure-clean) and are not held
against a branch. Exits when every branch is done. Meant for the Monitor tool: every line is an event.
"""
import json, subprocess, sys, time

REPO = "Jordan08/GAOL"
CORE = {"Linux", "macOS", "Windows", "Autotools and meson", "Linux containers"}


def gh(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip()[:200])
    return r.stdout


def head_sha(branch):
    return gh("api", "repos/%s/git/ref/heads/%s" % (REPO, branch), "--jq", ".object.sha").strip()


def push_runs(branch, sha):
    out = gh("run", "list", "--branch", branch, "--limit", "60", "--json", "databaseId,name,event,status,conclusion,headSha,url")
    return [r for r in json.loads(out) if r["headSha"] == sha and r["event"] == "push"]


def failed_jobs(run_id):
    jobs = json.loads(gh("run", "view", str(run_id), "--json", "jobs"))["jobs"]
    return [j["name"] for j in jobs if j["conclusion"] not in ("success", "skipped", None)]


def main():
    args = sys.argv[1:]
    baseline, interval, branches, listfile = set(), 60, [], None
    i = 0
    while i < len(args):
        if args[i] == "--baseline":
            baseline.add(args[i + 1]); i += 2
        elif args[i] == "--interval":
            interval = int(args[i + 1]); i += 2
        elif args[i] == "--list":
            listfile = args[i + 1]; i += 2
        else:
            branches.append(args[i]); i += 1
    import os
    statefile = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "ci", "watch.state.json")
    last, done = {}, {}    # (branch, sha) -> {run name: state}; (branch, sha) -> summary already printed
    try:
        saved = json.load(open(statefile))
        last = {tuple(k.split("|")): v for k, v in saved["last"].items()}
        done = {tuple(k.split("|")): True for k in saved["done"]}
    except (OSError, ValueError, KeyError):
        pass
    while True:
        if listfile:
            try:
                branches = [l.split("#")[0].strip() for l in open(listfile) if l.split("#")[0].strip()]
            except OSError:
                branches = []
        for b in branches:
            try:
                sha = head_sha(b)
                runs = push_runs(b, sha)
            except RuntimeError as e:
                print("%s: gh error (%s)" % (b, e), flush=True)
                continue
            state = {r["name"]: (r["status"] if r["status"] != "completed" else "completed/" + (r["conclusion"] or "?")) for r in runs}
            key = (b, sha)
            prev = last.get(key, {})
            for name, st in sorted(state.items()):
                if prev.get(name) != st and st.startswith("completed"):
                    print("%s [%s] %s: %s" % (b, sha[:7], name, st), flush=True)
            last[key] = state
            if done.get(key) or not CORE <= set(state):
                continue
            if all(r["status"] == "completed" for r in runs):
                red = []
                for r in runs:
                    if r["conclusion"] not in ("success", "skipped"):
                        jobs = [j for j in failed_jobs(r["databaseId"]) if j not in baseline]
                        if jobs or r["conclusion"] not in ("failure",):
                            red.append("%s: %s (%s)" % (r["name"], ", ".join(jobs) or r["conclusion"], r["url"]))
                done[key] = True
                print("%s [%s] DONE %s" % (b, sha[:7], ("red: " + " | ".join(red)) if red else "green"), flush=True)
        try:
            json.dump({"last": {"|".join(k): v for k, v in last.items()}, "done": ["|".join(k) for k in done]}, open(statefile, "w"))
        except OSError:
            pass
        if not listfile and all(any(k[0] == b and done[k] for k in done) for b in branches):
            break
        time.sleep(interval)


if __name__ == "__main__":
    main()
