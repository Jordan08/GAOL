#!/usr/bin/env python3
"""bundle <id> <branch|text> : writes $SCR/reports/<id>-bundle.json = the author's report, the reviews of the point and the
CI text. If the second argument is a branch of origin, the CI text is built from its push runs on the head commit
(links, conclusions, failing jobs, the baseline job noted)."""
import json, glob, sys, os, subprocess
SCR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
MAIN = "/home/jninin/Documents/WORK/DEV/GAOL/GAOL_V8"
BASELINE = {"Debian 12 Bookworm arm64": "https://github.com/Jordan08/GAOL/actions/runs/36489260950"}
def gh(*a):
    return subprocess.run(["gh", *a], cwd=MAIN, capture_output=True, text=True).stdout
pid, arg = sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else ""
ci = arg
if arg.startswith("todo-") or arg.startswith("fix-"):
    sha = gh("api", "repos/Jordan08/GAOL/git/ref/heads/" + arg, "--jq", ".object.sha").strip()
    runs = [r for r in json.loads(gh("run", "list", "--branch", arg, "--limit", "60", "--json", "databaseId,name,event,status,conclusion,headSha,url")) if r["headSha"] == sha and r["event"] == "push"]
    lines = []
    for r in sorted(runs, key=lambda r: r["name"]):
        s = "%s : %s (%s)" % (r["name"], r["url"], r["conclusion"] or r["status"])
        if r["conclusion"] not in ("success", "skipped", None):
            jobs = json.loads(gh("run", "view", str(r["databaseId"]), "--json", "jobs"))["jobs"]
            bad = [j["name"] for j in jobs if j["conclusion"] not in ("success", "skipped", None)]
            ok = len(jobs) - len(bad)
            s += " ; %d jobs sur %d réussis ; en échec : %s" % (ok, len(jobs), ", ".join(bad))
            for j in bad:
                if j in BASELINE:
                    s += " ; le job « %s » échoue déjà, de la même façon, sur configure-clean elle-même au commit a2ca992 (run %s) : le test numbers y est interrompu, sans rapport avec cette branche" % (j, BASELINE[j])
        lines.append(s)
    ci = "Runs de la branche %s au commit %s, tous terminés :\n" % (arg, sha[:7]) + "\n".join("- " + l for l in lines) + "\nMettre la ligne {{ARM64}} juste après cette liste si un job est en échec sur la base (le texte en est fourni par l'assistant)."
b = {"impl": json.load(open("%s/reports/%s-impl.json" % (SCR, pid))), "reviews": {}, "ci": ci}
for f in sorted(glob.glob("%s/reports/review-%s-*.json" % (SCR, pid))):
    b["reviews"][os.path.basename(f)[:-5]] = json.load(open(f))
json.dump(b, open("%s/reports/%s-bundle.json" % (SCR, pid), "w"), indent=1, ensure_ascii=False)
print(ci)
