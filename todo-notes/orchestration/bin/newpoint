#!/bin/bash
# newpoint <slug> <branch> [base]
# Creates the worktree $SCR/wt/<slug> on the new branch <branch> made from <base>
# (default: the commit of origin/configure-clean this session works from).
# Idempotent: an existing worktree is left as it is.
SCR="$(cd "$(dirname "$0")/.." && pwd)"
MAIN=/home/jninin/Documents/WORK/DEV/GAOL/GAOL_V8
BASE_DEFAULT=4776f1ec79a6be048a64f817c2166680385b36fc
slug=$1; branch=$2; base=${3:-$BASE_DEFAULT}
[ -n "$slug" ] && [ -n "$branch" ] || { echo "usage: newpoint <slug> <branch> [base]" >&2; exit 2; }
wt="$SCR/wt/$slug"
if [ -d "$wt/.git" ] || [ -f "$wt/.git" ]; then echo "worktree $wt exists (branch: $(git -C "$wt" rev-parse --abbrev-ref HEAD))"; exit 0; fi
cd "$MAIN" || exit 1
if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
  git worktree add "$wt" "$branch" || exit 1
else
  git worktree add -b "$branch" "$wt" "$base" || exit 1
fi
mkdir -p "$SCR/tmp/$slug"
echo "worktree $wt on branch $branch (from $(git -C "$wt" log -1 --format='%h %s' "$base" | cut -c1-80))"
