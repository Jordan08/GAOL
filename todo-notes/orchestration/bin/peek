#!/usr/bin/env python3
"""peek <agent-transcript.jsonl> [n=12]: the last n steps of an agent (tool calls and texts), truncated."""
import json, sys
f = sys.argv[1]; n = int(sys.argv[2]) if len(sys.argv) > 2 else 12
steps = []
for line in open(f, errors="replace"):
    try: m = json.loads(line)
    except Exception: continue
    msg = m.get("message") or {}
    c = msg.get("content")
    if isinstance(c, str):
        steps.append((m.get("type"), "text", c[:300])); continue
    for b in c or []:
        if b.get("type") == "tool_use":
            inp = b.get("input", {})
            s = inp.get("command") or inp.get("file_path") or inp.get("pattern") or json.dumps(inp)[:200]
            steps.append(("tool", b.get("name"), str(s)[:260].replace("\n", " ; ")))
        elif b.get("type") == "text" and m.get("type") == "assistant":
            steps.append(("say", "", b.get("text", "")[:300].replace("\n", " ")))
        elif b.get("type") == "tool_result":
            cc = b.get("content")
            if isinstance(cc, list): cc = " ".join(x.get("text", "") for x in cc if isinstance(x, dict))
            steps.append(("result", "", str(cc)[:160].replace("\n", " ; ")))
for s in steps[-n:]:
    print(" | ".join(x for x in s if x))
print("(%d steps in total)" % len(steps))
