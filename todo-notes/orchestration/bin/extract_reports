#!/usr/bin/env python3
"""extract_reports: copies the results of the agents of every workflow journal to $SCR/reports:
impl:<id> -> <id>-impl.json (the last one), review:<id>:<lens>:<round> -> review-<id>-<lens>-<round>.json, fix:<id>:<n> -> fix-<id>-<n>.json"""
import json, os
SCR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
D = "/home/jninin/.claude/projects/-home-jninin-Documents-WORK-DEV-GAOL-GAOL-V8/334ea319-d088-4702-9b10-e0628647c222/subagents/workflows"
out = SCR + "/reports"; os.makedirs(out, exist_ok=True); n = 0
for wf in sorted(os.listdir(D)):
    jp = os.path.join(D, wf, "journal.jsonl")
    if not os.path.exists(jp): continue
    labels = {}
    for line in open(jp):
        try: e = json.loads(line)
        except Exception: continue
        if e.get("type") == "started": labels[e.get("key")] = e.get("label")
        elif e.get("type") == "result" and isinstance(e.get("result"), dict):
            lab = labels.get(e.get("key")) or e.get("label") or ""
            r = e["result"]
            if lab.startswith("impl:"): name = "%s-impl.json" % lab.split(":")[1]
            elif lab.startswith("review:"): name = "review-%s.json" % lab[len("review:"):].replace(":", "-")
            elif lab.startswith("fix:"): name = "fix-%s.json" % lab[len("fix:"):].replace(":", "-")
            else: continue
            json.dump(r, open(os.path.join(out, name), "w"), indent=1, ensure_ascii=False); n += 1
print(n, "results copied;", len(os.listdir(out)), "files")
