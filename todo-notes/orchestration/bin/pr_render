#!/usr/bin/env python3
"""pr_render <id> create|edit|show : renders the pull request of point <id> from $SCR/pr/<file>.md and .title, substituting
{{PR:<id>}} (by #number, or "(pull request à ouvrir)"), {{ARM64}}, {{OVERLAPS}}, {{CI}} from $SCR/pr/registry.json,
refuses a text that credits Claude, and creates (base configure-clean) or edits the pull request with gh."""
import json, os, re, subprocess, sys
SCR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
MAIN = "/home/jninin/Documents/WORK/DEV/GAOL/GAOL_V8"
REG = SCR + "/pr/registry.json"
reg = json.load(open(REG)) if os.path.exists(REG) else {"prs": {}, "branches": {}, "files": {}, "overlaps": {}, "arm64": "", "ci": {}}
pid, mode = sys.argv[1], sys.argv[2]
fname = reg["files"].get(pid, "%02d" % int(pid) if pid.isdigit() else pid)
body = open("%s/pr/%s.md" % (SCR, fname)).read()
title = open("%s/pr/%s.title" % (SCR, fname)).read().strip()
def pr_ref(m):
    n = reg["prs"].get(m.group(1))
    return "#%s" % n if n else "(pull request à ouvrir)"
body = re.sub(r"\{\{PR:([^}]+)\}\}", pr_ref, body)
body = body.replace("{{ARM64}}", reg.get("arm64", "")).replace("{{OVERLAPS}}", reg["overlaps"].get(pid, "")).replace("{{CI}}", reg["ci"].get(pid, ""))
body = re.sub(r"\n{3,}", "\n\n", body).strip() + "\n"
if re.search(r"claude|anthropic|generated with|co-authored-by|🤖", body + title, re.I):
    sys.exit("refused: the text credits Claude (or names it)")
if "{{" in body:
    sys.exit("refused: unresolved placeholder: " + re.search(r"\{\{[^}]*\}\}", body).group(0))
out = "%s/pr/%s.rendered.md" % (SCR, fname)
open(out, "w").write(body)
if mode == "show":
    print(title); print(); print(body)
elif mode == "create":
    branch = reg["branches"][pid]
    r = subprocess.run(["gh", "pr", "create", "--repo", "Jordan08/GAOL", "--base", "configure-clean", "--head", branch, "--title", title, "--body-file", out],
                       cwd=MAIN, capture_output=True, text=True)
    print(r.stdout.strip(), r.stderr.strip())
    m = re.search(r"/pull/(\d+)", r.stdout)
    if m:
        reg["prs"][pid] = int(m.group(1)); json.dump(reg, open(REG, "w"), indent=1, ensure_ascii=False)
elif mode == "edit":
    n = reg["prs"][pid]
    r = subprocess.run(["gh", "pr", "edit", str(n), "--repo", "Jordan08/GAOL", "--title", title, "--body-file", out], cwd=MAIN, capture_output=True, text=True)
    print(r.stdout.strip(), r.stderr.strip())
