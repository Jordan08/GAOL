#!/usr/bin/env python3
"""resolve_both <file>...: in each conflicted file, keeps both sides of every conflict (ours then theirs). Only for additive
conflicts (lists of bullets, of tests...). Prints the conflicts it resolved so that they can be read."""
import re, sys
for p in sys.argv[1:]:
    s = open(p).read(); n = 0
    def keep(m):
        global n; n += 1
        return m.group(1) + m.group(2)
    s2 = re.sub(r"<<<<<<< [^\n]*\n(.*?)=======\n(.*?)>>>>>>> [^\n]*\n", keep, s, flags=re.S)
    open(p, "w").write(s2); print("%s: %d conflict(s) kept both" % (p, n))
