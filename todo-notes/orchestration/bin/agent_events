#!/usr/bin/env python3
"""agent_events [workflow-id ...]: one line when an agent of the workflows completes (it called StructuredOutput:
its status/verdict is printed), and one line when an agent has been idle for more than 25 minutes.
Runs until killed. For the Monitor tool."""
import json, os, sys, glob, time
ROOT = "/home/jninin/.claude/projects/-home-jninin-Documents-WORK-DEV-GAOL-GAOL-V8/334ea319-d088-4702-9b10-e0628647c222/subagents/workflows"
wfs = sys.argv[1:]
told, stuck = set(), set()
first = True
while True:
    for wf in (wfs or sorted(os.listdir(ROOT))):
        for meta in sorted(glob.glob(os.path.join(ROOT, wf, "agent-*.meta.json"))):
            jl = meta[:-len(".meta.json")] + ".jsonl"
            key = jl
            try:
                m = json.load(open(meta))
                done, result = False, None
                for line in open(jl, errors="replace"):
                    try: e = json.loads(line)
                    except Exception: continue
                    c = (e.get("message") or {}).get("content")
                    if isinstance(c, list):
                        for b in c:
                            if b.get("type") == "tool_use" and b.get("name") == "StructuredOutput":
                                done, result = True, b.get("input")
                age = (time.time() - os.path.getmtime(jl)) / 60
            except Exception:
                continue
            if done and key not in told:
                told.add(key)
                if first:
                    continue
                st = ""
                if isinstance(result, dict):
                    st = result.get("status") or result.get("verdict") or ""
                    if result.get("verdict") == "changes" or (result.get("blocking")):
                        st += " (%d blocking)" % len(result.get("blocking") or [])
                print("%s %s: %s" % (wf[-8:], m.get("description"), st or "done"), flush=True)
            elif not done and age > 25 and key not in stuck:
                stuck.add(key)
                print("%s %s: IDLE for %.0f min" % (wf[-8:], m.get("description"), age), flush=True)
    first = False
    time.sleep(60)
