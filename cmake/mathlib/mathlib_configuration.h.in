/* mathlib_configuration.h -- written by CMake from
   cmake/mathlib/mathlib_configuration.h.in of the CMake build of GAOL.

   This is the header that mathlib's configure script writes, for every
   compiler: prepare.cmake replaces src/mathlib_config_msvc.h and
   src/mathlib_config_mingw.h, the configuration files src/mathlib_config.h
   includes instead for Visual C++ and MinGW, with files including this one.

   Origin: the version of src/mathlib_configuration.h.in with which IBEX builds
   mathlib with CMake (https://github.com/ibex-team/ibex-lib,
   interval_lib_wrapper/gaol/3rd/mathlib-2.1.1/, Cyril Bouvier and Gilles
   Chabert), itself generated from mathlib's configure.ac. Only the macros
   mathlib's sources read are kept, and the ones describing the target are set
   by the preprocessor below rather than by the build system. */

#ifndef MATHLIB_CONFIGURATION_H
#define MATHLIB_CONFIGURATION_H

/* Define to 1 if you have the <fenv.h> header file. */
#cmakedefine HAVE_FENV_H 1

/* Define WORDS_BIGENDIAN to 1 if your processor stores words with the most
   significant byte first. Read by src/AARCH64_endian.h. The test on
   __BYTE_ORDER__, which GCC and Clang define, is the one of the fork of mathlib
   by Fabrice Le Bars (https://github.com/lebarsfa/mathlib,
   src/mathlib_endian.h); Visual C++ only targets little-endian processors. */
#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
#  define WORDS_BIGENDIAN 1
#endif

/* Define this if your system is ix86-based. src/endian.h then takes the byte
   order from src/IX86_endian.h, and from src/AARCH64_endian.h otherwise. */
#if defined(__i386__) || defined(__x86_64__) || defined(_M_IX86) || (defined(_M_X64) && !defined(_M_ARM64EC))
#  define IX86_CPU 1
#endif

/* The implementation of Init_Lib() and Exit_Lib(), which src/DPChange.c
   includes according to the macros below. mathlib's algorithms need doubles
   computed with 53 bits of precision and rounded to nearest; Init_Lib() puts
   the floating-point unit in that state, and GAOL calls it at initialisation.

   The versions of mathlib's own build are kept where they apply: */
#if defined(__linux__) && defined(__x86_64__)
/* src/LINUX64_DPChange.c, as configure.ac chooses on x86_64 Linux. */
#  define MATHLIB_LINUX 1
#  define X86_64BITS 1
#elif defined(__APPLE__) && (defined(__x86_64__) || defined(__i386__))
/* src/IX86MACOSX_DPChange.c, as configure.ac chooses on an Intel Mac. */
#  define MATHLIB_I86_MACOSX 1
#elif defined(__MINGW32__) && defined(__i386__)
/* src/LINUX_DPChange.c, as src/mathlib_config_mingw.h chooses for MinGW. */
#  define MATHLIB_MINGW 1
#else
/* Everywhere else, src/AARCH64_DPChange.c, which configure.ac chooses on ARM64
   Linux: Init_Lib() restores the default floating-point environment
   (fesetenv(FE_DFL_ENV)), which rounds to nearest, and nothing in it is
   specific to ARM64. The other versions would not do:
    - Visual C++: src/MSVC_DPChange.c is 32-bit x86 assembly, which Visual C++
      compiles for no other processor; on 32-bit x86, Visual C++ computes
      doubles in SSE2, and Windows sets the precision of the x87 to 53 bits.
    - MinGW on x86_64: src/LINUX_DPChange.c is 32-bit x86 assembly as well,
      which names its variables with the decoration of 32-bit Windows.
    - Linux on 32-bit x86: src/LINUX_DPChange.c reaches its variables through
      absolute addresses, which linkers refuse in a shared library. The CMake
      build of GAOL computes doubles in SSE2 there instead, which leaves nothing
      to the precision of the x87.
    - Other processors, 32-bit ARM among them, have no extended precision. */
#  define MATHLIB_AARCH64 1
#endif

#endif /* MATHLIB_CONFIGURATION_H */
