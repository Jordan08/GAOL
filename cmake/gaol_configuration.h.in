/* gaol/gaol_configuration.h, written by CMake from
   cmake/gaol_configuration.h.in.

   The macros are the same with the three builds, CMake
   (cmake/gaol_configuration.h.in), configure (gaol/gaol_configuration.h.in)
   and meson (gaol/gaol_configuration_meson.h.in), and are all GAOL's sources
   read of the build: doc/building.md lists them. What GAOL needs to know of
   the processor and the system, and the sizes of the integer types, come from
   the macros of the compiler (gaol/gaol_config.h). Every compiler includes
   this header, through gaol/gaol_config.h. (GAOL v5)

   Origin: the version of gaol/gaol_configuration.h.in with which IBEX builds
   GAOL with CMake (https://github.com/ibex-team/ibex-lib,
   interval_lib_wrapper/gaol/3rd/gaol-4.2.3alpha0/, Cyril Bouvier and Gilles
   Chabert), itself generated from GAOL's configure.ac. */

#ifndef __gaol_configuration_h__
#define __gaol_configuration_h__

/* The version of GAOL: 5, 0, 0 and "5.0.0" for GAOL 5.0.0 */
#define GAOL_MAJOR_VERSION @PROJECT_VERSION_MAJOR@
#define GAOL_MINOR_VERSION @PROJECT_VERSION_MINOR@
#define GAOL_MICRO_VERSION @PROJECT_VERSION_PATCH@
#define GAOL_VERSION "@PROJECT_VERSION@"

/* Defined to 1 by a Debug build (CMAKE_BUILD_TYPE=Debug, configure
   --enable-debug, meson --buildtype=debug): GAOL checks its assertions
   (gaol/gaol_assert.h) */
#cmakedefine GAOL_DEBUGGING 1

/* Defined to 1 to raise exceptions instead of aborting: always with CMake,
   by default with configure (--disable-exceptions) and meson
   (-Denable-exception=false) */
#cmakedefine GAOL_EXCEPTIONS_ENABLED 1

/* Defined to 1 to restore the rounding direction after each operation,
   rather than leaving it upward (GAOL_PRESERVE_ROUNDING,
   --enable-preserve-rounding, -Denable-preserve-rounding=true; see
   gaol/gaol_fpu.h) */
#cmakedefine GAOL_PRESERVE_ROUNDING 1

/* Defined to 1 to use the assembly of gaol/gaol_fpu_fenv.h, which serves
   32-bit x86 Linux and macOS only (GAOL_ASM, --enable-asm, -Denable-asm:
   on by default; never with Visual C++) */
#cmakedefine GAOL_USING_ASM 1

/* Defined to 1 to write a line on the standard error when GAOL initializes
   and cleans up (GAOL_VERBOSE_MODE, --enable-verbose-mode,
   -Denable-verbose-mode=true; off by default) */
#cmakedefine GAOL_VERBOSE_MODE 1

/* Defined to 1 where the intervals are computed with SSE2 instructions
   (x86 processors, but 32-bit Windows and Visual C++; GAOL_SIMD,
   --enable-simd, -Denable-simd, on by default) */
#cmakedefine GAOL_USING_SSE2_INSTRUCTIONS 1

/* Defined to 1 where they are compiled with -msse3 too */
#cmakedefine GAOL_USING_SSE3_INSTRUCTIONS 1

/* Defined to 1 where the compiler takes -frounding-math: GAOL then negates
   a double with the minus sign (gaol/gaol_port.h) */
#cmakedefine GAOL_HAVE_ROUNDING_MATH_OPTION 1

/* Defined to 1 where the library is compiled with -fvisibility=hidden:
   GAOL's public declarations then carry __attribute__ ((visibility("default")))
   (gaol/gaol_config.h) */
#cmakedefine GAOL_HAVE_VISIBILITY_OPTIONS 1

/* Defined to 1 where the compiler has <fenv.h> */
#cmakedefine GAOL_HAVE_FENV_H 1

/* Defined to 1 where <sys/resource.h> declares getrusage(), which
   gaol/gaol_profile.cpp measures the time with (clock() otherwise) */
#cmakedefine GAOL_HAVE_GETRUSAGE 1

#endif /* __gaol_configuration_h__ */
