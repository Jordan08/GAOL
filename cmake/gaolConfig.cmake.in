# CMake package of GAOL, installed by the CMake build of GAOL (CMakeLists.txt).
#
#   find_package(gaol)
#   target_link_libraries(<target> PRIVATE gaol::gaol)
#
# gaol::gaol carries GAOL's include directory, the compilation flags interval
# arithmetic needs (-frounding-math, -ffp-contract=off, /fp:strict...), the
# flag of the fused multiply-add instructions GAOL is compiled with (-mfma,
# /arch:AVX2..., GAOL_FMA; -mfma -mprefer-vector-width=128 with GCC for Windows
# on x86-64 and 32-bit x86, GAOL v5), on 32-bit Windows with the SSE2 intervals (GCC and
# Clang) the flag that has the compiler ask for the aligned memory they need
# (-faligned-new=8, for the C++ only), and, where GAOL's compiler takes it, the link
# option -mno-daz-ftz, given to the code built by GCC 13 or a later one, or by
# GAOL's compiler of its major version and not older (GCC has the option from
# 11.4 and 12.4 in the series 11 and 12 only). The elementary functions come
# from CORE-MATH, whose sources are compiled into libgaol: there is no other
# library to link.

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/gaolTargets.cmake")

check_required_components(gaol)
