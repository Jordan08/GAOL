+// GAOL v5: the size of the interval, or Infinity for an unbounded one
+void print_gap(double lower, double upper)
+{
+    if (lower == lower && upper >= lower && (lower == -std::numeric_limits<double>::infinity() || upper == std::numeric_limits<double>::infinity()))
+        printf("Infinity");
+    else
+        print_rational(interval_size(lower, upper));
+}
+
+// GAOL v5: what the scripts of doc/compare/tang2021 of GAOL need around the tests
+// - INTERVALS_SHARD=k/n runs the expressions whose rank modulo n is k only, so that n
+//   processes share the expressions;
+// - the drawn inputs of each expression come from the generator seeded with the name of the
+//   expression, whatever the expressions run before it;
+// - the query lines are preceded by the name of the expression and by its inputs, exactly,
+//   that GAOL's checker reads (lines without ": ", which Mathematica's script skips).
+bool begin_expression(const char *name)
+{
+    static int rank = -1;
+    static int shard = 0, shards = 1;
+    if (rank < 0)
+    {
+        const char *s = std::getenv("INTERVALS_SHARD");
+        if (s == nullptr || std::sscanf(s, "%d/%d", &shard, &shards) != 2 || shards < 1 || shard < 0 || shard >= shards)
+            shard = 0, shards = 1;
+    }
+    rank++;
+    if (rank % shards != shard)
+        return false;
+    unsigned long seed = 5381; // djb2
+    for (const char *c = name; *c != '\0'; c++)
+        seed = seed * 33 + static_cast<unsigned char>(*c);
+    generator.seed(static_cast<std::default_random_engine::result_type>(seed % 2147483646UL + 1));
+    return true;
+}
+
+void print_inputs(int variable_count)
+{
+    printf("INPUT");
+    for (int i = 0; i < variable_count; i++)
+        printf(", %a", comp_doubles[i]);
+    printf("\n");
+}
