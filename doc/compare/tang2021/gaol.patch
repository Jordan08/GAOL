+	target_link_libraries(intervals PUBLIC Boost::boost)
+endif()
+
+# GAOL v5: GAOL, found through its CMake package (CMAKE_PREFIX_PATH or gaol_DIR);
+# gaol::gaol gives the flags a program using GAOL is compiled with
+# (-frounding-math, -ffp-contract=off...), to the whole benchmark
+option(INTERVALS_WITH_GAOL "Benchmark GAOL too" ON)
+if (INTERVALS_WITH_GAOL)
+	find_package(gaol CONFIG REQUIRED)
+	message("GAOL ${gaol_VERSION} = ${gaol_DIR}")
+	target_compile_definitions(intervals PUBLIC USE_GAOL)
+	target_link_libraries(intervals PUBLIC gaol::gaol)
+endif()
 
 # add filib c++ library for interval
