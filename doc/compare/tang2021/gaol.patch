--- a/src/interval.hpp
+++ b/src/interval.hpp
@@ -35,6 +35,10 @@ double upper(fic_interval v)
 // ==============================================================================================
 // ==============================================================================================
 // include boost interval
+// GAOL v5: only when CMake found Boost (USE_BOOST); WITH_BOOST(...) keeps its
+// lines of the tests, and drops them otherwise
+#ifdef USE_BOOST
+#define WITH_BOOST(...) __VA_ARGS__
 #if defined(__APPLE__)
 #warning "__APPLE__ defined so explicitly defining __USE_ISOC99"
 #define __USE_ISOC99
@@ -70,6 +74,9 @@ double upper(boost_interval v)
 {
     return v.upper();
 }
+#else
+#define WITH_BOOST(...)
+#endif
 // ==============================================================================================
 // ==============================================================================================
 
@@ -95,3 +102,33 @@ double upper(T v)
 #endif
 // ==================================================================================================================
 // ==================================================================================================================
+
+// ==================================================================================================================
+// ==================================================================================================================
+// GAOL v5: include GAOL (https://github.com/Jordan08/GAOL), when CMake found it (USE_GAOL)
+// GAOL computes with the rounding direction upward, and leaves it upward for the whole
+// program, from its initialization (before main()) on, unless it is built with
+// GAOL_PRESERVE_ROUNDING. GAOL_END(), after the lines of GAOL, sets the direction to nearest
+// again with gaol::restore_rounding(), as GAOL's documentation advises a program that needs
+// it: the other libraries (filib's C version is written for rounding to nearest) and the
+// doubles of the benchmark itself (the drawing and the checking of the inputs) are then
+// computed to nearest, as in a run without GAOL. GAOL's operations set the direction upward
+// themselves.
+#ifdef USE_GAOL
+#include <gaol/gaol.h>
+typedef gaol::interval gaol_interval;
+double lower(const gaol_interval &v)
+{
+    return v.left();
+}
+double upper(const gaol_interval &v)
+{
+    return v.right();
+}
+#define GAOL_END() gaol::restore_rounding()
+#define WITH_GAOL(...) __VA_ARGS__
+#else
+#define WITH_GAOL(...)
+#endif
+// ==================================================================================================================
+// ==================================================================================================================
